# NOTE: every path pattern here is ROOT-ANCHORED (leading "/").
# An unanchored "data/" also matches "src/data/", which silently excluded the
# entire data package from the first commit and broke the Kaggle run.
# Keep the leading slash.

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Generated corpora and training artifacts (regenerate with src/data/build_dataset.py)
/data/
/outputs/
/runs/
*.safetensors
*.bin

# Results ARE committed: comparison.csv, figures/, error_analysis.json and
# cv_metrics.md are deliverables. Only bulky per-example dumps are excluded.
/results/*/predictions.jsonl
/results/*failures.jsonl
/results/*/failures.jsonl

# Kaggle results pulled down with `kaggle kernels output`. Generated, and it
# contains a nested clone of this repo -- git records that as a gitlink
# (mode 160000), not as files, so committing it stores a dangling pointer to a
# commit rather than any content. Re-fetch it when needed.
/kaggle/output/

# Same reasoning, plus ~280 MB of zips: the Kaggle output download. Adapters in
# here are published as a Kaggle Dataset by scripts/publish_adapters.sh, not
# committed to git.
/kaggle-outputs/

# Results downloaded from Modal evaluation jobs.
/modal-results/

# Staging directory used by scripts/publish_adapters.sh
/.kaggle-adapters-stage/

# Local
.venv/
venv/
.env
.DS_Store
